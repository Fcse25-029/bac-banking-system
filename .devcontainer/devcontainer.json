{
  "name": "BAC BANKING SYSTEM",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "true" },
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop (open this to see the app)", "onAutoForward": "notify" }
  },
  "containerEnv": { "DISPLAY": ":1" },
  "postCreateCommand": "mvn -q dependency:resolve",
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}
